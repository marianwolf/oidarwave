    {
      "id": "claim_6bae1c69027f4e2888266956d65d2423",
      "statement": "The audio player reacts to media events: loadstart clears the stalled flag and updates the overall status; canplay starts playback via playMedia() if paused and resets error/retry state; playing clears error/retry flags, sets wasPlayingBeforeError, starts StationHistory.startStation(src) and sets a baseline Media Session; pause (without error) cancels pending retries and stops history; waiting marks buffering; error sets hasError, stops history, and schedules an auto-retry.",
      "evidence": [
        {
          "resource": "repo://src/js/history.js#L116-L127",
