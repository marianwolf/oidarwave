{
  "name": "oidarwave",
  "version": "0.9.14",
  "description": "Minimalistisches Webradio für deinen Desktop",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux AppImage",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "author": "Marian Wolf <marianwolf200@gmail.com> (http://oidarwave.vercel.com/)",
  "license": "MIT",
  "build": {
    "appId": "com.oidarwave.app",
    "productName": "Oidarwave",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "index.html",
      "favicon/**/*",
      "manifest.json",
      "video/**/*",
      "impressum/**/*"
    ],
    "compression": "normal",
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "favicon/favicon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "favicon/favicon.icns",
      "category": "public.app-category.audio"
    },
    "dmg": {
      "iconSize": 80,
      "window": {
        "width": 660,
        "height": 400
      }
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "icon": "favicon/favicon.svg"
    }
  },
  "devDependencies": {
    "electron": "^41.5.0",
    "electron-builder": "^26.8.1"
  }
}
