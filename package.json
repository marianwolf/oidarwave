{
  "name": "oidarwave",
  "version": "0.9.18",
  "description": "Webradio für deinen Desktop",
  "main": "electron/main.js",
  "desktopName": "app.oidarwave.vercel",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:linux": "electron-builder -l",
    "dist:win": "electron-builder -w",
    "dist:mac": "electron-builder -m",
    "format": "prettier --write ."
  },
  "author": "Marian Wolf <marianwolf200@gmail.com> (http://oidarwave.vercel.com/)",
  "license": "MIT",
  "build": {
    "appId": "app.oidarwave.vercel",
    "productName": "Oidarwave",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "index.html",
      "favicon/**/*",
      "manifest.json",
      "video/**/*",
      "impressum/**/*"
    ],
    "compression": "normal",
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "favicon/favicon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        "zip"
      ],
      "icon": "favicon/favicon.icns",
      "category": "public.app-category.audio"
    },
    "dmg": {
      "iconSize": 80,
      "window": {
        "width": 660,
        "height": 400
      }
    },
    "linux": {
      "syncDesktopName": true,
      "category": "AudioVideo",
      "icon": "favicon/favicon.svg",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "freebsd",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "snap",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "devDependencies": {
    "@openai/codex": "^0.161.0",
    "@opencode/cli": "^2.2.5",
    "bootstrap": "^5.3.8",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "freebuff": "^0.0.177",
    "openwiki": "^0.7.3",
    "prettier": "^3.9.10"
  },
  "allowScripts": {
    "@opencode/cli": true,
    "better-sqlite3": true,
    "electron-winstaller": true,
    "ejs": true
  },
  "dependencies": {
    "electron-log": "^5.4.4"
  }
}
