{
  "name": "oidarwave",
  "version": "0.9.16",
  "description": "Webradio für deinen Desktop",
  "main": "electron/main.js",
  "desktopName": "app.oidarwave.vercel",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:linux": "electron-builder -l",
    "dist:win": "electron-builder -w",
    "dist:mac": "electron-builder -m"
  },
  "author": "Marian Wolf <marianwolf200@gmail.com> (http://oidarwave.vercel.com/)",
  "license": "MIT",
  "build": {
    "appId": "app.oidarwave.vercel",
    "productName": "Oidarwave",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "index.html",
      "favicon/**/*",
      "manifest.json",
      "video/**/*",
      "impressum/**/*"
    ],
    "compression": "normal",
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "favicon/favicon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        "zip"
      ],
      "icon": "favicon/favicon.icns",
      "category": "public.app-category.audio"
    },
    "dmg": {
      "iconSize": 80,
      "window": {
        "width": 660,
        "height": 400
      }
    },
    "linux": {
      "syncDesktopName": true,
      "category": "AudioVideo",
      "icon": "favicon/favicon.svg",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "freebsd",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "snap",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "devDependencies": {
    "@eslint/css": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.0",
    "@eslint/markdown": "^8.0.3",
    "@opencode/cli": "^2.0.17",
    "electron": "^44.4.5",
    "electron-builder": "^26.16.1",
    "electron-log": "^5.4.4",
    "eslint": "^10.11.0",
    "freebuff": "^0.0.177",
    "globals": "^17.12.0",
    "openwiki": "^0.6.0"
  },
  "allowScripts": {
    "@opencode/cli": true,
    "better-sqlite3": true,
    "electron-winstaller": true
  }
}
