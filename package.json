{
  "name": "oidarwave",
  "version": "0.9.13",
  "description": "Minimalistisches Webradio für deinen Desktop",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux AppImage"
  },
  "author": "Marian Wolf",
  "license": "MIT",
  "build": {
    "appId": "com.oidarwave.app",
    "productName": "Oidarwave",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "index.html",
      "favicon.svg",
      "manifest.json",
      "build/**/*"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo",
      "icon": "build/icon.png"
    }
  },
  "devDependencies": {
    "electron": "^41.5.0",
    "electron-builder": "^26.8.1"
  }
}
